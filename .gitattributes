# 统一换行，避免跨平台协作时把 shell 脚本改成 CRLF 导致设备上跑不起来
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf

# PowerShell 脚本使用 UTF-8 BOM + CRLF，便于 Windows PowerShell 5.1 正确读取中文
*.ps1   text eol=crlf

# 二进制
*.jpg   binary
*.png   binary
*.apk   binary
*.jar   binary
*.keystore binary
